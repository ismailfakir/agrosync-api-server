{
  "compilerOptions": {
    "target": "ES2022",
    //"module": "commonjs",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    //"module": "ESNext", 
    //"moduleResolution": "Bundler",
    //"noUncheckedIndexedAccess": true,
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.test.ts"]
}